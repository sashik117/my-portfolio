{
  "name": "premium-fullstack-portfolio",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w client",
    "lint": "npm run lint -w client",
    "audit:env": "npm run audit:env -w server",
    "verify:seo": "npm run verify:seo -w client",
    "test:e2e": "npm run test:e2e -w client",
    "test:e2e:production": "npm run test:e2e:production -w client",
    "test:server": "npm test -w server",
    "verify:cloudinary": "npm run verify:cloudinary -w server",
    "verify:smtp": "npm run verify:smtp -w server"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
