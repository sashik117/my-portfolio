NODE_ENV=production
PORT=5050
CLIENT_URLS=https://your-portfolio.vercel.app

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/portfolio
MONGODB_DB=portfolio
JWT_SECRET=replace-with-a-long-random-production-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

ADMIN_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=portfolio_refresh
REFRESH_COOKIE_SAMESITE=none
REFRESH_COOKIE_SECURE=true

FILE_STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio-projects

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Portfolio <no-reply@example.com>
CONTACT_TO=hello@example.com
