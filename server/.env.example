PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3000,http://localhost:3003,http://localhost:3178
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/portfolio
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=portfolio_refresh
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Upload storage: local or cloudinary
FILE_STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio-projects

# Optional email delivery for contact form
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Portfolio <no-reply@example.com>
CONTACT_TO=hello@example.com
